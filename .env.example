# Runtime
APP_ENV=development
APP_TIMEZONE=America/Santiago
LOG_LEVEL=INFO

# Local persistence (Phase 1 candidate)
DATABASE_URL=sqlite:///data/local/faroflow.db

# Separate local persistence for the Finanzas area (CuentaFaro domain).
# Two SQLite files keep the independent migration chains and data realms apart.
CUENTAFARO_DATABASE_URL=sqlite:///data/local/cuentafaro.db

# External integrations stay disabled until their local authorization is configured.
# Add real values only to a local .env file; never commit credentials.
GOOGLE_DRIVE_ENABLED=false
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_CALENDAR_ENABLED=false
MICROSOFT_CALENDAR_ENABLED=false
MICROSOFT_CALENDAR_IDS=default
MICROSOFT_GRAPH_TIMEOUT_SECONDS=15
WHATSAPP_ENABLED=false
LLM_PROVIDER=
LLM_API_KEY=

# Integration history retention (days of sync runs and their errors to keep).
INTEGRATION_SYNC_HISTORY_RETENTION_DAYS=90

# Optional gate for integration mutations (sync, ingest, retry, links, mappings).
# Enable+key to require X-Integration-Key on those endpoints; leave false to keep open locally.
INTEGRATION_OPERATIONS_ENABLED=false
INTEGRATION_OPERATION_KEY=
