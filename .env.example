# Runtime
APP_ENV=development
APP_TIMEZONE=America/Santiago
LOG_LEVEL=INFO

# Local persistence (Phase 1 candidate)
DATABASE_URL=sqlite:///data/local/jonathan_ai_pm.db

# External integrations stay disabled until their local authorization is configured.
# Add real values only to a local .env file; never commit credentials.
GOOGLE_DRIVE_ENABLED=false
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_CALENDAR_ENABLED=false
MICROSOFT_CALENDAR_ENABLED=false
MICROSOFT_CALENDAR_IDS=default
MICROSOFT_GRAPH_SCOPES=Calendars.ReadBasic
MICROSOFT_GRAPH_TIMEOUT_SECONDS=15
INTEGRATION_SYNC_HISTORY_RETENTION_DAYS=90
INTEGRATION_RESOLVED_REVIEW_RETENTION_DAYS=30
INTEGRATION_OPERATIONS_ENABLED=false
INTEGRATION_OPERATION_KEY=
INTEGRATION_MAX_SYNC_WINDOW_DAYS=31
WHATSAPP_ENABLED=false
LLM_PROVIDER=
LLM_API_KEY=
