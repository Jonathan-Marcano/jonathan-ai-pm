# Runtime
APP_ENV=development
APP_TIMEZONE=America/Santiago
LOG_LEVEL=INFO

# Local persistence.
# Within Faro Flow this variable is CUENTAFARO_DATABASE_URL so it never
# collides with the Faro Flow work database (DATABASE_URL).
DATABASE_URL=sqlite:///data/local/cuentafaro.db
CUENTAFARO_DATABASE_URL=sqlite:///data/local/cuentafaro.db

# Currency base
BASE_CURRENCY=CLP

# External integrations stay disabled until authorized.
# Add real values only to a local .env file; never commit credentials.
WHATSAPP_ENABLED=false
LLM_PROVIDER=
LLM_API_KEY=